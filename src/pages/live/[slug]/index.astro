---
import { sitePath, prefixProgramLinks } from "../../../lib/site-path";
import Layout from "../../../layouts/Layout.astro";
import configData from "../../../../config.json";
import { marked } from "marked";
export function getStaticPaths() {
  return configData.groups.map((g) => ({ params: { slug: g.slug } }));
}
const { slug } = Astro.params;
const res = configData.groups.find((g) => g.slug === slug)!;
const files = import.meta.glob("../../../../contents/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});
const content = files[`../../../../contents/${res.programma}`];
const programmaContentHtml = content
  ? await marked.parse(content as string)
  : "";

---

<Layout
  title={`Streaming ${res.title} | ${configData.title}`}
  description={`Segui le arene e il programma gare di ${res.title} a ${res.location}.`}
>
  <main class="detail-page">
    <section class="detail-banner">
      <div class="content-shell detail-banner-inner">
        <a class="breadcrumb" href={sitePath("/#centri")}>← Tutti i centri ippici</a><p
          class="eyebrow"
        >
          CENTRO IPPICO · STREAMING
        </p><h1>{res.title}</h1><p class="detail-location">⌖ {res.location}</p>
      </div><div class="detail-banner__crest" aria-hidden="true"><img src={sitePath(`/images/${res.image}`)} alt="" /></div>
    </section><section class="content-shell detail-content">
      <div class="detail-intro">
        <div>
          <span class="small-rule"></span><h2>Scegli la tua arena</h2><p>
            Segui il live streaming degli eventi equestri di {res.title} a {res.location}. Scegli un’arena e consulta il programma delle gare.
          </p>
        </div><span class="venue-count"
          >{res.links.length}
          {res.links.length === 1 ? "ARENA" : "ARENE"}</span>
      </div><div class="arena-grid">
        {
          res.links.map((l) => (
            <a class="arena-card" href={sitePath(`/live/${res.slug}/${l.slug}/`)}>
              <>
                <span class="arena-icon">▶</span>
                <span>
                  <>
                    <strong>{l.title}</strong>
                    <small>
                      {l.link
                        ? "Accedi allo streaming"
                        : "Streaming non disponibile"}
                    </small>
                  </>
                </span>
                <span class="arena-arrow">↗</span>
              </>
            </a>
          ))
        }
      </div>{
        programmaContentHtml && (
          <div class="program-card">
            <>
              <h2>Programma e informazioni</h2>
              <div class="program-content" set:html={prefixProgramLinks(programmaContentHtml)} />
            </>
          </div>
        )
      }{
        res.imageProgramma && (
          <img
            class="program-image"
            src={sitePath(`/images/${res.imageProgramma}`)}
            alt={`Programma ${res.title}`}
            loading="lazy"
          />
        )
      }
    </section>
  </main>
</Layout>
