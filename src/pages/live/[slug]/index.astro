---
import { sitePath } from "../../../lib/site-path";
import { hasFeaturedLogo } from "../../../lib/venue-logos";
import Layout from "../../../layouts/Layout.astro";
import configData from "../../../../config.json";
import VenueProgram from "../../../components/VenueProgram.astro";
export function getStaticPaths() {
  return configData.groups.map((g) => ({ params: { slug: g.slug } }));
}
const { slug } = Astro.params;
const res = configData.groups.find((g) => g.slug === slug)!;
---

<Layout
  title={`Streaming ${res.title} | ${configData.title}`}
  description={`Segui le arene e il programma gare di ${res.title} a ${res.location}.`}
>
  <main class="detail-page">
    <section class="detail-banner">
      <div class="content-shell detail-banner-inner">
        <div>
          <a class="breadcrumb" href={sitePath("/#centri")}>← Torna alle dirette</a>
          <p class="eyebrow">CENTRO IPPICO · STREAMING</p>
          <h1>{res.title}</h1>
          <p class="detail-location">⌖ {res.location}</p>
        </div>
        <div
          class:list={[
            "detail-banner__crest",
            { "detail-banner__crest--large": hasFeaturedLogo(res.slug) },
          ]}
          aria-hidden="true"
        >
          <img src={sitePath(`/images/${res.image}`)} alt="" />
        </div>
      </div>
    </section>
    <section class="content-shell detail-content">
      <div class="detail-intro">
        <div>
          <span class="small-rule"></span><h2>Scegli la tua arena</h2><p>
            Segui il live streaming degli eventi equestri di {res.title} a {res.location}. Scegli un’arena e consulta il programma delle gare.
          </p>
        </div><span class="venue-count"
          >{res.links.length}
          {res.links.length === 1 ? "ARENA" : "ARENE"}</span>
      </div><div class="arena-grid">
        {
          res.links.map((l) => (
            <a class="arena-card" href={sitePath(`/live/${res.slug}/${l.slug}/`)}>
              <>
                <span class="arena-icon">▶</span>
                <span>
                  <>
                    <strong>{l.title}</strong>
                    <small>
                      {l.link
                        ? "Accedi allo streaming"
                        : "Streaming non disponibile"}
                    </small>
                  </>
                </span>
                <span class="arena-arrow">↗</span>
              </>
            </a>
          ))
        }
      </div>
      <VenueProgram filename={res.programma} />
      {
        res.imageProgramma && (
          <img
            class="program-image"
            src={sitePath(`/images/${res.imageProgramma}`)}
            alt={`Programma ${res.title}`}
            loading="lazy"
          />
        )
      }
    </section>
  </main>
</Layout>
