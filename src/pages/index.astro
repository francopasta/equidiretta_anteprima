---
import { sitePath } from "../lib/site-path";
import Layout from "../layouts/Layout.astro";
import configData from "../../config.json";
export const prerender = true;
const venues = configData.groups;
const pageTitle = `Live streaming eventi equestri in diretta | ${configData.title}`;
const pageDescription = `Segui le gare di equitazione e scopri le arene in streaming dai centri ippici italiani: ${venues.map((g) => g.title).join(", ")}.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-art" aria-hidden="true"></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="content-shell hero-content">
        <span class="eyebrow hero-eyebrow"
          ><span class="eyebrow-line"></span> IL TUO POSTO IN PRIMA FILA</span
        >
        <h1 id="hero-title">
          Ogni salto.<br />Ogni emozione.<br /><em>In diretta.</em>
        </h1>
        <div class="gold-stroke"></div>
        <p>
          Vivi il meglio dell'equitazione, ovunque tu sia. Le emozioni dei campi
          gara, sempre a portata di clic.
        </p>
        <div class="hero-buttons">
          <a class="button button-gold" href="#dirette"
            ><span aria-hidden="true">▶</span> Scopri le dirette</a
          ><a class="button button-outline" href="#centri"
            >⌖ &nbsp;Esplora i centri</a>
        </div>
      </div>
    </section>
    <section class="venues-section" id="dirette" aria-labelledby="venues-title">
      <div class="content-shell">
        <div class="section-heading">
          <div>
            <span class="small-rule"></span><p class="eyebrow">
              IL MONDO EQUESTRE, SEMPRE CON TE
            </p><h2 id="venues-title">Segui i tuoi centri preferiti</h2><p
              class="section-subtitle"
            >
              Scegli il centro ippico e accedi alle sue arene in streaming.
            </p>
          </div><span class="venue-count">{venues.length} CENTRI IPPICI</span>
        </div>
        <div class="venue-grid" id="centri">
          {
            venues.map((g) => (
              <article class="venue-card">
                <>
                  <a
                    class="venue-card__photo"
                    href={sitePath(`/live/${g.slug}/`)}
                    aria-label={`Apri ${g.title}`}
                  >
                    <>
                      <img
                        src={sitePath(`/images/${g.image}`)}
                        alt=""
                        loading="lazy"
                      />
                      <span class="venue-card__pill">
                        {g.links.length}{" "}
                        {g.links.length === 1 ? "arena" : "arene"}
                      </span>
                    </>
                  </a>
                  <div class="venue-card__body">
                    <>
                      <h3>
                        <a href={sitePath(`/live/${g.slug}/`)}>{g.title}</a>
                      </h3>
                      <p class="venue-location">
                        <span aria-hidden="true">⌖</span> {g.location}
                      </p>
                      <a class="venue-card__button" href={sitePath(`/live/${g.slug}/`)}>
                        <span aria-hidden="true">▶</span> Guarda {configData.actions.vedi}{" "}
                        <span aria-hidden="true">↗</span>
                      </a>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="benefits">
      <div class="content-shell benefits-inner">
        <div class="benefits-title">
          <span class="small-rule"></span><h2>
            Tutto il mondo equestre,<br />in un unico posto.
          </h2><p>La passione per il cavallo non si ferma mai.</p>
        </div><div class="benefit">
          <span class="benefit-icon" aria-hidden="true">▦</span><h3>
            Centri ippici
          </h3><p>Trova la tua sede e scegli l'arena che vuoi seguire.</p>
        </div><div class="benefit">
          <span class="benefit-icon" aria-hidden="true">▱</span><h3>
            Multi-arena
          </h3><p>Accedi ai diversi campi gara di ogni evento.</p>
        </div><div class="benefit">
          <span class="benefit-icon" aria-hidden="true">▣</span><h3>
            Streaming
          </h3><p>Segui le gare da computer, tablet e smartphone.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
