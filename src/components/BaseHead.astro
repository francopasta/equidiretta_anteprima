---
import { sitePath } from "../lib/site-path";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/images/hero-equestrian.jpg" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(sitePath(image), Astro.site);
const localPreview = import.meta.env.PUBLIC_EQUIDIRETTA_PRODUCTION !== "true";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href={sitePath("/images/ed-marchio.png")} />
<meta name="generator" content={Astro.generator} />
<link rel="sitemap" href={sitePath("/sitemap-index.xml")} />
{!localPreview && <link rel="canonical" href={canonicalURL} />}
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content={localPreview ? "noindex, nofollow" : "index, follow"} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<ClientRouter />
