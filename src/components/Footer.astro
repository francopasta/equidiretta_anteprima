---
import { sitePath } from "../lib/site-path";
import configData from "../../config.json";
---

<footer class="site-footer">
  <div class="content-shell footer-inner">
    <div>
      <a href={sitePath("/")} class="footer-brand">EQUIDIRETTA<span>.TV</span></a><p>
        Le emozioni dell'equitazione, ovunque tu sia.
      </p>
    </div><div class="footer-links">
      <a href={sitePath("/#dirette")}>Dirette</a><a href={sitePath("/#centri")}>Centri ippici</a><a
        href={sitePath("/blog/")}>Blog</a
      ><a href={sitePath("/contatti/")}>Contatti</a><a href={sitePath("/privacy/")}>Privacy</a><a
        href={sitePath("/cookie/")}>Cookie</a>
    </div><small>© {new Date().getFullYear()} {configData.title}</small>
  </div>
</footer>
