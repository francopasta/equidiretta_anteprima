---
import { sitePath } from "../lib/site-path";
---

<nav class="site-nav" aria-label="Navigazione principale">
  <div class="site-nav__inner">
    <a class="brand" href={sitePath("/")} aria-label="Equidiretta.tv, pagina iniziale">
      <img class="brand-mark" src={sitePath("/images/ed-marchio.png")} alt="" />
      <span>EQUIDIRETTA<span class="brand-dot">.TV</span></span>
    </a>
    <div class="site-nav__links" id="main-menu">
      <a href={sitePath("/#dirette")}>Dirette</a>
      <a href={sitePath("/blog/")}>Blog</a>
      <a href={sitePath("/contatti/")}>Contatti</a>
    </div>
    <a href={sitePath("/#dirette")} class="nav-cta" aria-label="Guarda le dirette">
      <span aria-hidden="true">▶</span> Guarda le dirette
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-controls="main-menu"
      aria-expanded="false"
      aria-label="Apri menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const menu = document.querySelector<HTMLElement>("#main-menu");
    if (!toggle || !menu) return;

    function setOpen(open: boolean) {
      toggle?.setAttribute("aria-expanded", String(open));
      toggle?.setAttribute("aria-label", open ? "Chiudi menu" : "Apri menu");
      menu?.classList.toggle("is-open", open);
    }

    toggle.onclick = () => setOpen(toggle.getAttribute("aria-expanded") !== "true");
    menu.onclick = (event) => {
      if (event.target instanceof Element && event.target.closest("a")) setOpen(false);
    };
    toggle.closest("nav")?.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  });
</script>
